    local function CheckPunchCollision(fist, punchType)
        local fistPosition = fist.Position
        
        -- 检测周围的玩家
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local targetChar = player.Character
                if targetChar then
                    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                    local torso = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
                    
                    if humanoid and humanoid.Health > 0 and torso then
                        local distance = (torso.Position - fistPosition).Magnitude
                        
                        -- 拳击范围
                        local punchRange = 4
                        if distance <= punchRange then
                            -- 计算击退方向
                            local direction = (torso.Position - RigHumanoidRootPart.Position).Unit
                            
                            -- 应用击退力
                            if PunchForce[punchType] then
                                local force = PunchForce[punchType]
                                
                                -- 确保目标部件存在
                                if torso and torso.Parent then
                                    -- 使用AssemblyLinearVelocity进行击退
                                    torso.AssemblyLinearVelocity = direction * force.X + Vector3.new(0, force.Y, 0)
                                    torso.AssemblyAngularVelocity = Vector3.new(
                                        math.random(-10, 10),
                                        math.random(-10, 10),
                                        math.random(-10, 10)
                                    )
                                end
                            end
                            
                            -- 造成伤害
                            if PunchDamage[punchType] then
                                -- 创建远程事件发送伤害（在FE环境中）
                                local args = {
                                    [1] = humanoid,
                                    [2] = PunchDamage[punchType],
                                    [3] = LocalPlayer
                                }
                                
                                -- 尝试使用不同的伤害方法
                                pcall(function()
                                    humanoid:TakeDamage(PunchDamage[punchType])
                                end)
                                
                                -- 尝试使用TouchInterest
                                pcall(function()
                                    humanoid.Health = humanoid.Health - PunchDamage[punchType]
                                end)
                            end
                            
                            -- 创建特效
                            CreatePunchEffect(torso.Position, punchType)
                            
                            -- 播放音效
                            local sound = Instance.new("Sound")
                            sound.SoundId = "rbxassetid://130976108"
                            sound.Volume = 0.5
                            sound.Parent = torso
                            sound:Play()
                            game.Debris:AddItem(sound, 2)
                            
                            return true
                        end
                    end
                end
            end
        end
        
        -- 检测环境物体
        for _, part in pairs(Workspace:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "Baseplate" and part ~= fist and part ~= LeftFist and part ~= RightFist then
                local distance = (part.Position - fistPosition).Magnitude
                
                if distance <= 4 and not part.Anchored and part.CanCollide then
                    -- 击飞物体
                    local direction = (part.Position - RigHumanoidRootPart.Position).Unit
                    part.AssemblyLinearVelocity = direction * PunchForce[punchType].X
                    part.AssemblyAngularVelocity = Vector3.new(
                        math.random(-20, 20),
                        math.random(-20, 20),
                        math.random(-20, 20)
                    )
                    
                    CreatePunchEffect(part.Position, punchType)
                    return true
                end
            end
        end
        
        return false
    end
    
    local function LightPunch(isLeftHand)
        if Punching or Blocking then return end
        if not ConsumeStamina(10) then return end
        if not CheckCooldown("Light") then return end
        
        Punching = true
        LastPunchTypeTime["Light"] = osclock()
        
        local fist = isLeftHand and LeftFist or RightFist
        local arm = isLeftHand and Rig:FindFirstChild("LeftHand") or Rig:FindFirstChild("RightHand")
        local weld = isLeftHand and LeftFistWeld or RightFistWeld
        
        if fist and arm and weld then
            local originalCF = weld.C0
            
            -- 向前出拳
            for i = 1, 10 do
                if arm and arm.Parent and weld then
                    weld.C0 = originalCF * CFrame.new(0, 0, -i * 0.15)
                    
                    -- 检测碰撞
                    if CheckPunchCollision(fist, "Light") then
                        ComboCount = ComboCount + 1
                        break
                    end
                    
                    taskwait(0.01)
                end
            end
            
            -- 短暂停留
            taskwait(0.05)
            
            -- 收回拳头
            for i = 10, 0, -2 do
                if arm and arm.Parent and weld then
                    weld.C0 = originalCF * CFrame.new(0, 0, -i * 0.15)
                    taskwait(0.01)
                end
            end
            
            -- 恢复原始位置
            if weld then
                weld.C0 = originalCF
            end
        end
        
        Punching = false
        LastPunchTime = osclock()
        
        -- 重置连击计时
        if osclock() - LastPunchTime > ComboResetTime then
            ComboCount = 0
        end
    end
    
