    local function UpdateStamina()
        local currentTime = osclock()
        
        -- 体力自然恢复
        if currentTime - LastStaminaUpdate > 0.1 then
            if Stamina < MaxStamina then
                Stamina = math.min(Stamina + StaminaRegenRate * 0.1, MaxStamina)
                LastStaminaUpdate = currentTime
            end
        end
        
        -- 更新UI
        if StaminaBar and StaminaText then
            local staminaPercent = Stamina / MaxStamina
            StaminaBar.Size = UDim2.new(staminaPercent, 0, 1, 0)
            
            -- 根据体力改变颜色
            if staminaPercent > 0.7 then
                StaminaBar.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            elseif staminaPercent > 0.3 then
                StaminaBar.BackgroundColor3 = Color3.fromRGB(200, 200, 0)
            else
                StaminaBar.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            end
            
            StaminaText.Text = string.format("体力: %d/%d", math.floor(Stamina), MaxStamina)
        end
        
        -- 更新连击显示
        if ComboText then
            ComboText.Text = "连击: " .. tostring(ComboCount)
            
            -- 根据连击数改变颜色
            if ComboCount >= 4 then
                ComboText.TextColor3 = Color3.fromRGB(255, 0, 0)
                ComboText.Text = "连击: " .. tostring(ComboCount) .. " (特殊!)"
            elseif ComboCount >= 2 then
                ComboText.TextColor3 = Color3.fromRGB(255, 255, 0)
            else
                ComboText.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end
    
    local function ConsumeStamina(amount)
        if Stamina >= amount then
            Stamina = Stamina - amount
            return true
        end
        return false
    end
    
    local function CheckCooldown(punchType)
        local currentTime = osclock()
        return currentTime - LastPunchTypeTime[punchType] >= PunchCooldowns[punchType]
    end
    
