    local function HookPunch(isLeftHand)
        if Punching or Blocking then return end
        if not ConsumeStamina(20) then return end
        if not CheckCooldown("Heavy") then return end
        
        Punching = true
        
        local fist = isLeftHand and LeftFist or RightFist
        local arm = isLeftHand and Rig:FindFirstChild("LeftHand") or Rig:FindFirstChild("RightArm")
        local weld = isLeftHand and LeftFistWeld or RightFistWeld
        
        if fist and arm and weld then
            local originalCF = weld.C0
            
            -- 勾拳轨迹
            for i = 1, 12 do
                if weld then
                    local angle = math.rad(i * 15)
                    local offsetX = isLeftHand and -math.sin(angle) * 0.5 or math.sin(angle) * 0.5
                    local offsetZ = -math.cos(angle) * 0.5
                    
                    weld.C0 = originalCF * CFrame.new(offsetX, 0, offsetZ) * CFrame.Angles(0, angle * 0.5, 0)
                    
                    -- 检测碰撞
                    if CheckPunchCollision(fist, "Heavy") then
                        ComboCount = ComboCount + 2
                        break
                    end
                    
                    taskwait(0.01)
                end
            end
            
            -- 恢复
            for i = 12, 0, -2 do
                if weld then
                    local angle = math.rad(i * 15)
                    local offsetX = isLeftHand and -math.sin(angle) * 0.5 or math.sin(angle) * 0.5
                    local offsetZ = -math.cos(angle) * 0.5
                    
                    weld.C0 = originalCF * CFrame.new(offsetX, 0, offsetZ) * CFrame.Angles(0, angle * 0.5, 0)
                    taskwait(0.01)
                end
            end
            
            if weld then
                weld.C0 = originalCF
            end
        end
        
        Punching = false
        LastPunchTime = osclock()
    end
    
    local function Uppercut()
        if Punching or Blocking then return end
        if not ConsumeStamina(35) then return end
        if not CheckCooldown("Combo") then return end
        
        Punching = true
        LastPunchTypeTime["Combo"] = osclock()
        
        if LeftFistWeld and RightFistWeld then
            local leftOriginal = LeftFistWeld.C0
            local rightOriginal = RightFistWeld.C0
            
            -- 双拳准备
            for i = 1, 5 do
                if LeftFistWeld and RightFistWeld then
                    LeftFistWeld.C0 = leftOriginal * CFrame.new(0, -i * 0.1, -i * 0.1)
                    RightFistWeld.C0 = rightOriginal * CFrame.new(0, -i * 0.1, -i * 0.1)
                    taskwait(0.03)
                end
            end
            
            -- 上勾拳
            for i = -5, 20 do
                if LeftFistWeld and RightFistWeld then
                    LeftFistWeld.C0 = leftOriginal * CFrame.new(0, i * 0.2, i * 0.1)
                    RightFistWeld.C0 = rightOriginal * CFrame.new(0, i * 0.2, i * 0.1)
                    
                    -- 检测双拳碰撞
                    CheckPunchCollision(LeftFist, "Combo")
                    CheckPunchCollision(RightFist, "Combo")
                    
                    taskwait(0.01)
                end
            end
            
            -- 恢复
            for i = 20, 0, -3 do
                if LeftFistWeld and RightFistWeld then
                    LeftFistWeld.C0 = leftOriginal * CFrame.new(0, i * 0.2, i * 0.1)
                    RightFistWeld.C0 = rightOriginal * CFrame.new(0, i * 0.2, i * 0.1)
                    taskwait(0.01)
                end
            end
            
            if LeftFistWeld and RightFistWeld then
                LeftFistWeld.C0 = leftOriginal
                RightFistWeld.C0 = rightOriginal
            end
        end
        
        Punching = false
        ComboCount = ComboCount + 3
        LastPunchTime = osclock()
    end
    
    local function SpecialAttack()
        if Punching or Blocking then return end
        if ComboCount < 4 then 
            if ComboText then
                ComboText.Text = "需要4连击才能使用特殊攻击!"
                taskwait(1)
            end
            return 
        end
        if not ConsumeStamina(50) then return end
        if not CheckCooldown("Special") then return end
        
        Punching = true
        LastPunchTypeTime["Special"] = osclock()
        
        -- 旋转攻击
        local rotationSpeed = 30
        local rotationTime = 0.8
        local startTime = osclock()
        
        while osclock() - startTime < rotationTime do
            if RigHumanoidRootPart then
                -- 旋转身体
                RigHumanoidRootPart.CFrame = RigHumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(rotationSpeed), 0)
                
                -- 伸展手臂
                if LeftFistWeld and RightFistWeld then
                    LeftFistWeld.C0 = LeftFistOriginalCF * CFrame.new(-2, 0, 0)
                    RightFistWeld.C0 = RightFistOriginalCF * CFrame.new(2, 0, 0)
                end
                
                -- 检测碰撞
                if LeftFist then CheckPunchCollision(LeftFist, "Special") end
                if RightFist then CheckPunchCollision(RightFist, "Special") end
            end
            taskwait()
        end
        
        -- 恢复
        if LeftFistWeld and RightFistWeld then
            LeftFistWeld.C0 = LeftFistOriginalCF
            RightFistWeld.C0 = RightFistOriginalCF
        end
        
        Punching = false
        ComboCount = 0
        LastPunchTime = osclock()
        
        -- 创建大范围特效
        if RigHumanoidRootPart then
            CreatePunchEffect(RigHumanoidRootPart.Position, "Special")
            
            -- 冲击波
            local shockwave = Instance.new("Part")
            shockwave.Size = Vector3.new(20, 1, 20)
