-- UI启动动画
local function playStartAnimation()
    -- 保存原始大小和位置
    local originalSize = Frame.Size
    local originalPosition = Frame.Position
    
    -- 初始状态：非常小且透明，位于屏幕中心
    Frame.Size = UDim2.new(0, 10, 0, 10)
    Frame.Position = UDim2.new(0.5, -5, 0.5, -5)
    Frame.BackgroundTransparency = 1
    Frame.Visible = true
    
    -- 第一步：放大到110%并淡入
    local scaleUp = TweenService:Create(Frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(originalSize.X.Scale * 1.1, originalSize.X.Offset * 1.1, 
                         originalSize.Y.Scale * 1.1, originalSize.Y.Offset * 1.1),
        BackgroundTransparency = 0.3
    })
    
    -- 第二步：缩回原始大小并完全显示
    local scaleBack = TweenService:Create(Frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = originalSize,
        Position = originalPosition,
        BackgroundTransparency = 0
    })
    
    -- 添加按钮的逐个显示效果
    local buttons = {up, down, onof, plus, speed, mine, TextLabel, closebutton, mini}
    for i, button in ipairs(buttons) do
        button.Visible = false
    end
    
    -- 执行动画
    scaleUp:Play()
    wait(0.5)
    scaleBack:Play()
    
    -- 按钮逐个显示动画
    wait(0.2)
    for i, button in ipairs(buttons) do
        button.Visible = true
        if button:IsA("TextButton") or button:IsA("TextLabel") then
            button.TextTransparency = 1
            local textFadeIn = TweenService:Create(button, TweenInfo.new(0.2), {
                TextTransparency = 0
            })
            textFadeIn:Play()
        end
        
        -- 轻微缩放效果
        local originalButtonSize = button.Size
        button.Size = UDim2.new(originalButtonSize.X.Scale * 0.8, originalButtonSize.X.Offset * 0.8,
                               originalButtonSize.Y.Scale * 0.8, originalButtonSize.Y.Offset * 0.8)
        local buttonScale = TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = originalButtonSize
        })
        buttonScale:Play()
        
        wait(0.05) -- 按钮之间的延迟
    end
end

-- 添加按钮悬停缩放动画
local function setupButtonHoverAnimations()
    local buttons = {up, down, onof, plus, mine, closebutton, mini, mini2}
    
    for _, button in ipairs(buttons) do
        local originalSize = button.Size
        
        button.MouseEnter:Connect(function()
            local hoverScale = TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(originalSize.X.Scale * 1.1, originalSize.X.Offset * 1.1,
                                originalSize.Y.Scale * 1.1, originalSize.Y.Offset * 1.1)
            })
            hoverScale:Play()
        end)
        
        button.MouseLeave:Connect(function()
            local resetScale = TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = originalSize
            })
            resetScale:Play()
        end)
    end
end

